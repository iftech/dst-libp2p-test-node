# Dynamic-linked nim test-node, for the Shadow simulator.
#
# Mirrors Dockerfile (same base, nimble and lockfile, amd64 only), plus the lsquic patch
# and -d:lsquic_no_sendmmsg. Shadow's syscall interposer only hooks dynamically linked
# ELFs, and it does not implement sendmmsg.
#
# Build via kaniko on a lab worker (see shadow/kaniko-build-test-node-job.yaml), once per
# NODE_BINARY.

FROM nimlang/nim:2.2.10 AS builder

WORKDIR /node

RUN apt-get update && apt-get install -y --no-install-recommends \
    git \
    build-essential \
    ca-certificates \
    curl \
    libssl3 \
    iproute2 \
    procps \
    && rm -rf /var/lib/apt/lists/*

RUN git config --global http.version HTTP/1.1

# fix #1837: honor locked package URLs during installation (#1838)
RUN nimble install -y 'nimble@#07caee397d628c9e93d81048268365c4c2414a80'
ENV PATH="/root/.nimble/bin:${PATH}"

COPY test_node.nimble nimble.lock config.nims ./
RUN nimble refresh && nimble setup

COPY . .

# Floor lsquic's engine tick re-arms so Shadow can advance simulated time, and let the
# build opt out of sendmmsg. Gated by LSQUIC_TICK_FLOOR_US (unset/0 = stock). See README.md.
RUN set -eu; \
    patched=0; \
    for d in /root/.nimble/pkgcache/*lsquic*/ /root/.nimble/pkgs2/lsquic-*/; do \
      [ -f "${d}lsquic/context/context.nim" ] || continue; \
      if grep -q tickFloorUs "${d}lsquic/context/context.nim"; then echo "already patched $d"; continue; fi; \
      ( cd "$d" && git apply -p1 /node/lsquic-tick-floor.patch ); \
      echo "patched $d"; patched=$((patched+1)); \
    done; \
    [ "$patched" -gt 0 ] || { echo "no lsquic package found to patch"; exit 1; }

ARG NODE_BINARY=node
RUN test "${NODE_BINARY}" = "node" -o "${NODE_BINARY}" = "bootstrap"
RUN nimble c \
    -d:chronicles_colors=None --threads:on --mm:refc \
    -d:metrics -d:libp2p_network_protocols_metrics -d:release \
    -d:lsquic_no_sendmmsg \
    --out:/node/main \
    "${NODE_BINARY}/main.nim" \
    && chmod +x /node/main \
    && (grep -l tickFloorUs /root/.nimble/pkgs2/lsquic-*/lsquic/context/context.nim \
        || echo "patch WIPED by nimble re-resolve") \
    && grep -qa LSQUIC_TICK_FLOOR_US /node/main \
    && echo "TICK-FLOOR VERIFIED IN BINARY"

# The binary and its runtime deps; an init container copies /node/main out for Shadow.
FROM debian:bookworm-slim

RUN apt-get update && apt-get install -y --no-install-recommends \
    libssl3 libgcc-s1 libstdc++6 ca-certificates \
    && rm -rf /var/lib/apt/lists/* \
    && apt-get clean

COPY --from=builder /node/main /node/main

ENTRYPOINT ["/node/main"]
